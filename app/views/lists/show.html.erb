<%= render "header", title: @list.name %>
<div class="container">
  <div class="movies">
    <% @list.movies.each do |movie| %>
      <div class="movie-card">
        <%= image_tag movie.poster_url, alt: "#{movie.title} poster" %>
        <div class="movie-card-infos">
          <div>
            <h2><%= movie.title %></h2>
            <p><%= movie.overview %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
