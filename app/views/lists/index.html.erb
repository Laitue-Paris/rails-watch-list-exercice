<%= render "header", title: "Enregistez vos listes de films et partagez les !" %>

<div class="container">
  <div class="d-flex justify-content-between">
    <h2>Mes listes !</h2>

  </div>
  <div class="lists">
    <% @lists.each do |list| %>
      <%= link_to list_path(list) do %>
        <div class="list-card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(https://raw.githubusercontent.com/lewagon/fullstack-images/master/uikit/breakfast.jpg)">
          <%= list.name %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
